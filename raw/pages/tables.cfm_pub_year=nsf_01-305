	/*
	* name: _sendNcsesEvent
	* usage: to set hit type to Event
	*/
	function _sendNcsesEvent(_cat, _act, _lbl, _val, _nonInteraction) {
		if (_cat != '' && _cat != undefined && _act != '' && _act != undefined) {
			/* Only send Events if in PROD environments */
